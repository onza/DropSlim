{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropSlim",
  "version": "../package.json",
  "identifier": "com.onza.dropslim",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:tauri && npm run ui:build",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DropSlim",
        "width": 480,
        "height": 840,
        "minWidth": 480,
        "minHeight": 840,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "gif", "svg", "webp", "avif"],
        "name": "Image",
        "role": "Editor"
      }
    ],
    "resources": ["resources/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": { "x": 168, "y": 240 },
        "applicationFolderPosition": { "x": 372, "y": 240 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCNTg1REM1QTEyOTIwOUYKUldTZklDbWh4VjFZRzJkN2JmZTU1TzhFbkpMbldQSjMrSzJVYVNCU0lEWXNSb0hHa25Sd3VZbHQK",
      "endpoints": [
        "https://github.com/onza/DropSlim/releases/latest/download/latest.json"
      ]
    }
  }
}
