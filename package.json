{
  "name": "dropslim",
  "version": "1.0.0",
  "description": "Optimize your images and graphics in a single drag and drop.",
  "author": "Martin Farkas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onza/DropSlim.git"
  },
  "homepage": "https://github.com/onza/DropSlim",
  "scripts": {
    "postinstall": "node scripts/install-gifsicle.mjs",
    "prepare": "husky",
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/build.sh",
    "pretest": "npm run prepare:tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "ci": "npm run ci:check && npm run ci:rust",
    "ci:check": "npm run lint && npm run format:check && npm run ui:build",
    "ci:rust": "npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:tauri": "node scripts/prepare-tauri.mjs",
    "version": "node scripts/sync-version.mjs",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "tauri": "tauri"
  },
  "keywords": [
    "image",
    "image-compression",
    "imagequant",
    "zenjpeg",
    "gifsicle",
    "webp",
    "avif",
    "dropslim",
    "optimize",
    "compress",
    "minify",
    "tauri"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.11.2",
    "bin-build": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "vite": "^6.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,yml,yaml,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-store": "^2.4.3"
  }
}
